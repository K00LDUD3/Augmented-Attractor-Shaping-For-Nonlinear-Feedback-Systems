{
    "n_envs": 1,
    "algo": "SAC",
    "total_timesteps": 10000,
    "device": "cuda",
    "env": {
        "name": "LunarLander-v3",
        "continuous": true,
        "gravity": -10,
        "enable_wind": false,
        "turbulence_power": 0,
        "wind_power": 0
    },
    "sac": {
        "policy": "MlpPolicy",
        "lr": 0.0003,
        "buffer_size": 1000000,
        "learning_starts": 1000,
        "batch_size": 256,
        "tau": 0.005,
        "gamma": 0.99,
        "train_freq": [
            1,
            "step"
        ],
        "gradient_steps": 1,
        "ent_coef": "auto"
    }
}